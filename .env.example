# Browser-facing legacy checkout origin used only by the isolated Razorpay test pages.
VITE_PAYGATE_CHECKOUT_URL=https://pay.mulearnscet.in

# Runtime-only nginx BFF settings for the PayGate v4 test flow.
# PAYGATE_V4_API_KEY must be a dedicated merchant key; never prefix it with VITE_.
PAYGATE_V4_API_URL=https://pay.mulearnscet.in
PAYGATE_V4_API_KEY=pg_live_key_example_replace_me

# Cutover compatibility only: existing deployments may keep these names.
# Explicit PAYGATE_V4_* values take precedence when both are present.
# PAYGATE_URL=https://pay.mulearnscet.in
# PAYGATE_API_KEY=<existing server-only merchant key>
