PAYGATE_URL=https://pay.mulearnscet.in
PAYGATE_API_KEY=replace-with-the-paygate-api-key
PORT=3000
TRUST_PROXY_HEADERS=false
PAYMENT_CREATE_LIMIT=5
PAYMENT_CREATE_WINDOW_SECONDS=300
PAYMENT_CREATE_GLOBAL_LIMIT=60
PAYMENT_CREATE_GLOBAL_WINDOW_SECONDS=60
PAYMENT_STATUS_LIMIT=180
PAYMENT_STATUS_WINDOW_SECONDS=60
PAYMENT_STATUS_GLOBAL_LIMIT=1800
PAYMENT_STATUS_GLOBAL_WINDOW_SECONDS=60

# Optional isolated Razorpay Test Mode rail. Never use Live Mode credentials here.
RAZORPAY_TEST_ENABLED=false
RAZORPAY_TEST_URL=http://paygate-razorpay-test:3000
RAZORPAY_TEST_API_KEY=

# Hidden ₹1 Razorpay Live pilot. Keep disabled until the isolated Live service is healthy.
RAZORPAY_LIVE_ENABLED=false
RAZORPAY_LIVE_URL=http://paygate-razorpay-live:3000
RAZORPAY_LIVE_API_KEY=
